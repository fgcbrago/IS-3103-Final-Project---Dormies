{
  "name": "dormies-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Dormies Dormitory Management System - REST API (Express.js + Prisma + MySQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sql": "node scripts/make-sql.js",
    "seed": "node src/config/seed.js",
    "reset": "node src/config/seed.js --reset",
    "test": "node scripts/setup-test-db.js && node --test --test-concurrency=1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.5"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
